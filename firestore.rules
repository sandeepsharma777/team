rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Allow open reads for public directories (colleges, published opportunities, showcases)
    // and standard write rules for application interactions
    match /colleges/{collegeId} {
      allow read, write: if true;
    }

    match /profiles/{profileId} {
      allow read, write: if true;
    }

    match /opportunities/{opportunityId} {
      allow read, write: if true;
    }

    match /opportunity_rules/{ruleId} {
      allow read, write: if true;
    }

    match /teams/{teamId} {
      allow read, write: if true;
    }

    match /team_members/{memberId} {
      allow read, write: if true;
    }

    match /team_join_requests/{requestId} {
      allow read, write: if true;
    }

    match /team_invitations/{invitationId} {
      allow read, write: if true;
    }

    match /projects/{projectId} {
      allow read, write: if true;
    }

    match /team_chat_messages/{messageId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
