{
  "entities": {
    "colleges": {
      "title": "Colleges",
      "description": "Colleges and universities available in TeamSync",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "profiles": {
      "title": "Profiles",
      "description": "Student and user profiles in TeamSync",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "full_name": { "type": "string" },
        "avatar_url": { "type": "string" },
        "college_name": { "type": "string" },
        "year_of_study": { "type": "string" },
        "branch": { "type": "string" },
        "bio": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "interests": { "type": "array", "items": { "type": "string" } },
        "github_url": { "type": "string" },
        "linkedin_url": { "type": "string" },
        "portfolio_url": { "type": "string" },
        "resume_url": { "type": "string" },
        "is_open_to_teams": { "type": "boolean" },
        "role": { "type": "string", "enum": ["student", "organizer", "admin"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "full_name"]
    },
    "opportunities": {
      "title": "Opportunities",
      "description": "Hackathons, challenges, and project opportunities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "short_description": { "type": "string" },
        "description": { "type": "string" },
        "organizer": { "type": "string" },
        "category": { "type": "string" },
        "participation_mode": { "type": "string" },
        "status": { "type": "string" },
        "is_published": { "type": "boolean" },
        "location": { "type": "string" },
        "start_date": { "type": "string", "format": "date-time" },
        "end_date": { "type": "string", "format": "date-time" },
        "registration_deadline": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "organizer", "category"]
    },
    "opportunity_rules": {
      "title": "Opportunity Rules",
      "description": "Validation and eligibility rules for team formation in opportunities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "opportunity_id": { "type": "string" },
        "min_team_size": { "type": "number" },
        "max_team_size": { "type": "number" },
        "exact_team_size": { "type": "number" },
        "composition_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "target": { "type": "string" },
              "count": { "type": "number" }
            }
          }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "opportunity_id"]
    },
    "teams": {
      "title": "Teams",
      "description": "Project & Hackathon Teams",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "opportunity_id": { "type": "string" },
        "leader_id": { "type": "string" },
        "required_skills": { "type": "array", "items": { "type": "string" } },
        "required_roles": { "type": "array", "items": { "type": "string" } },
        "custom_rules": { "type": "object" },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "leader_id"]
    },
    "team_members": {
      "title": "Team Members",
      "description": "Memberships of users in teams",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "team_id": { "type": "string" },
        "user_id": { "type": "string" },
        "role_in_team": { "type": "string" },
        "is_leader": { "type": "boolean" },
        "joined_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "team_id", "user_id"]
    },
    "team_join_requests": {
      "title": "Team Join Requests",
      "description": "Student requests to join teams",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "team_id": { "type": "string" },
        "user_id": { "type": "string" },
        "role_interested": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "team_id", "user_id", "status"]
    },
    "team_invitations": {
      "title": "Team Invitations",
      "description": "Invitations sent by team leaders to students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "team_id": { "type": "string" },
        "user_id": { "type": "string" },
        "invited_by": { "type": "string" },
        "role_offered": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "team_id", "user_id", "status"]
    },
    "projects": {
      "title": "Projects",
      "description": "Showcased portfolio projects and hackathon submissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "team_id": { "type": "string" },
        "opportunity_id": { "type": "string" },
        "repo_url": { "type": "string" },
        "live_url": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "outcome": { "type": "string" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "created_by"]
    },
    "team_chat_messages": {
      "title": "Team Chat Messages",
      "description": "Real-time communication messages for teams",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "team_id": { "type": "string" },
        "user_id": { "type": "string" },
        "message": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "team_id", "user_id", "message"]
    },
    "notifications": {
      "title": "Notifications",
      "description": "In-app notifications for team updates and invitations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipient_id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "related_entity_type": { "type": "string" },
        "related_entity_id": { "type": "string" },
        "is_read": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipient_id", "title", "message"]
    }
  },
  "firestore": {
    "colleges": {
      "schema": "colleges",
      "description": "Colleges and universities list"
    },
    "profiles": {
      "schema": "profiles",
      "description": "Student profiles and credentials"
    },
    "opportunities": {
      "schema": "opportunities",
      "description": "Hackathons, competitions, and project opportunities"
    },
    "opportunity_rules": {
      "schema": "opportunity_rules",
      "description": "Opportunity rules and constraints"
    },
    "teams": {
      "schema": "teams",
      "description": "Student teams"
    },
    "team_members": {
      "schema": "team_members",
      "description": "Team membership records"
    },
    "team_join_requests": {
      "schema": "team_join_requests",
      "description": "Join requests for teams"
    },
    "team_invitations": {
      "schema": "team_invitations",
      "description": "Team invitations"
    },
    "projects": {
      "schema": "projects",
      "description": "Project showcases and portfolio items"
    },
    "team_chat_messages": {
      "schema": "team_chat_messages",
      "description": "Team chat messages"
    },
    "notifications": {
      "schema": "notifications",
      "description": "User notifications"
    }
  }
}
